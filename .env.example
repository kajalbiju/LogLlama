# Host port for the Docker PostgreSQL. Change it when a native PostgreSQL already listens on 5432.
LOGLLAMA_POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://logllama:logllama@localhost:5432/logllama
# Test runs use a separate database whose name ends in _test. Migrations and tests reset it.
# TEST_DATABASE_URL=postgresql+asyncpg://logllama:logllama@localhost:5432/logllama_test
LOGLLAMA_DEFAULT_API_KEY=llama-dev-key
LOGLLAMA_DEFAULT_PROJECT_NAME=Development
# Development key seeding is for local use only. A runtime key must be 32+ random characters.
# Generate one with: openssl rand -hex 32
# LOGLLAMA_DEFAULT_RUNTIME_KEY=

# Accounts and sessions. Sign-up creates an organization. The first account on a fresh install claims the seeded
# Development organization, so LOGLLAMA_DEFAULT_API_KEY keeps working.
LOGLLAMA_ALLOW_SIGNUP=true
LOGLLAMA_SESSION_TTL_HOURS=12
# Set to true behind HTTPS so the session cookie is only sent over TLS.
LOGLLAMA_COOKIE_SECURE=false
# Browser origins that may call the API with credentials. Use the same host as the dashboard (127.0.0.1 or localhost).
LOGLLAMA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGLLAMA_MAX_BATCH_EVENTS=500
LOGLLAMA_MAX_REQUEST_BYTES=5000000

LOGLLAMA_SECRET_BACKEND=memory
LOGLLAMA_ALLOW_EPHEMERAL_SECRETS=false
LOGLLAMA_SECRET_PREFIX=logllama
# AWS_REGION=us-east-1
# Persistent local/production backend (run scripts/openbao-local-bootstrap.sh first):
# LOGLLAMA_SECRET_BACKEND=openbao
# LOGLLAMA_SECRET_STORE_ADDR=http://127.0.0.1:8200
# LOGLLAMA_SECRET_STORE_MOUNT=secret
# LOGLLAMA_SECRET_STORE_TIMEOUT_SECONDS=2
# LOGLLAMA_SECRET_STORE_ROLE_ID_FILE=/absolute/path/to/.openbao/role-id
# LOGLLAMA_SECRET_STORE_SECRET_ID_FILE=/absolute/path/to/.openbao/secret-id
# Static tokens remain supported, but AppRole files are preferred:
# LOGLLAMA_SECRET_STORE_TOKEN=
# LOGLLAMA_SECRET_STORE_TOKEN_FILE=
# LOGLLAMA_SECRET_STORE_NAMESPACE=

LOGLLAMA_API_KEY=llama-dev-key
# Set this to the same value as LOGLLAMA_DEFAULT_RUNTIME_KEY only when using managed credentials.
# LOGLLAMA_RUNTIME_KEY=
LOGLLAMA_ENDPOINT=http://localhost:8000
LOGLLAMA_TIMEOUT_SECONDS=1
LOGLLAMA_BATCH_SIZE=50
LOGLLAMA_FLUSH_INTERVAL_SECONDS=1
LOGLLAMA_MAX_QUEUE_SIZE=10000
LOGLLAMA_CAPTURE_PROMPTS=true
LOGLLAMA_CAPTURE_RESPONSES=true
LOGLLAMA_SERVICE_NAME=demo-api
LOGLLAMA_ENVIRONMENT=local
LOGLLAMA_VERSION=0.1.0
LOGLLAMA_GIT_SHA=local-dev
LOGLLAMA_TAGS=demo,local
LOGLLAMA_REDACT_KEYS=password,authorization,api_key,email,token,secret,ssn,cookie
LOGLLAMA_MAX_PROMPT_SIZE=20000
LOGLLAMA_MAX_RESPONSE_SIZE=50000
LOGLLAMA_METADATA_ALLOWLIST=
LOGLLAMA_METADATA_DENYLIST=ssn,credit_card,password
LOGLLAMA_SAMPLE_RATE=1
LOGLLAMA_CAPTURE_ERRORS=true
LOGLLAMA_CAPTURE_OTEL=true
LOGLLAMA_ENABLED=true

# Live integration tests load provider keys from the Provider tab via LOGLLAMA_RUNTIME_KEY.
# They read captured events back through the dashboard API, so they also need an account and project:
# LOGLLAMA_DASHBOARD_EMAIL=
# LOGLLAMA_DASHBOARD_PASSWORD=
# LOGLLAMA_PROJECT_ID=
# OPENAI_API_KEY, GEMINI_API_KEY, and GOOGLE_API_KEY are removed before clients are built.
RUN_LOGLLAMA_OPENAI_INTEGRATION=0
LOGLLAMA_OPENAI_TEST_MODEL=gpt-5-nano
LOGLLAMA_OPENAI_SUCCESS_RUNS=1
RUN_LOGLLAMA_GEMINI_INTEGRATION=0
LOGLLAMA_GEMINI_TEST_MODEL=gemini-3.5-flash-lite
LOGLLAMA_GEMINI_SUCCESS_RUNS=1
